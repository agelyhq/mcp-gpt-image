# Required. Standard OpenAI variable, reused as-is.
OPENAI_API_KEY=sk-...

# Where generated images are written. Created on first use.
GPT_IMAGE_OUTPUT_DIR=./generated-images

# Image model. Set to gpt-image-2-2026-04-21 to pin a snapshot and freeze behaviour.
GPT_IMAGE_MODEL=gpt-image-2

# Seconds before an image call is abandoned. Large sizes and complex prompts are slow.
GPT_IMAGE_TIMEOUT=300

# Same, for refine_image, which runs a reasoning model in front of the drawing.
GPT_IMAGE_REFINE_TIMEOUT=300

# The chat model that drives the image tool during refinement. The default,
# chat-latest, always points at the newest one. Pin an exact id here to freeze
# behaviour or to trade cost against quality, for example gpt-5.6-luna.
GPT_IMAGE_REFINE_MODEL=chat-latest
